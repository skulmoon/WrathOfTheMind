; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Will of Crystal"
config/description="This is my first game."
config/version="0.1.3.1"
run/main_scene="res://Data/Scenes/Menu/MainMenu.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
config/icon="uid://76uaibnxt4c0"

[autoload]

Global="*res://Data/Scripts/Global/Global.cs"
Storage="*res://Data/Scenes/Tools/Storage.tscn"

[display]

window/size/mode=3

[dotnet]

project/assembly_name="WrathOfTheMind"

[file_customization]

