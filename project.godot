"res://Data/Dialogs/": "orange",
"res://Data/PAMS/": "orange",
"res://Data/Resources/": "yellow",
"res://Data/Scenes/": "gray",
"res://Data/Sounds/": "teal",
"res://Data/Textures/": "purple",
"res://Data/Translations/": "red"
}

